<templateSet group="Felidae">
    <template name="import" value="import &quot;$V1$&quot;." description="Import a Felidae source file" toReformat="false" toShortenFQNames="false">
        <variable name="V1" expression="" defaultValue="&quot;file.fx&quot;" alwaysStopAt="true"/>
        <context>
            <option name="OTHER" value="true"/>
        </context>
    </template>

    <template name="fact" value="def $V1$($V2$: $V3$, $V4$: $V5$)." description="Declare a persistent fact seed" toReformat="false" toShortenFQNames="false">
        <variable name="V1" expression="" defaultValue="&quot;employee&quot;" alwaysStopAt="true"/>
        <variable name="V2" expression="" defaultValue="&quot;id&quot;" alwaysStopAt="true"/>
        <variable name="V3" expression="" defaultValue="&quot;\&quot;e1\&quot;&quot;" alwaysStopAt="true"/>
        <variable name="V4" expression="" defaultValue="&quot;state&quot;" alwaysStopAt="true"/>
        <variable name="V5" expression="" defaultValue="&quot;active&quot;" alwaysStopAt="true"/>
        <context>
            <option name="OTHER" value="true"/>
        </context>
    </template>

    <template name="binding" value="def $V1$$V2$ := $V4$." description="Declare an immutable interpreter binding" toReformat="false" toShortenFQNames="false">
        <variable name="V1" expression="" defaultValue="&quot;value&quot;" alwaysStopAt="true"/>
        <variable name="V2" expression="" defaultValue="&quot;: any&quot;" alwaysStopAt="true"/>
        <variable name="V4" expression="" defaultValue="&quot;expression&quot;" alwaysStopAt="true"/>
        <context>
            <option name="OTHER" value="true"/>
        </context>
    </template>

    <template name="function" value="def $V1$($V2$: $V3$) =&gt;&#10;    $V4$.&#10;end" description="Declare an implicit-result function" toReformat="false" toShortenFQNames="false">
        <variable name="V1" expression="" defaultValue="&quot;name&quot;" alwaysStopAt="true"/>
        <variable name="V2" expression="" defaultValue="&quot;value&quot;" alwaysStopAt="true"/>
        <variable name="V3" expression="" defaultValue="&quot;any&quot;" alwaysStopAt="true"/>
        <variable name="V4" expression="" defaultValue="&quot;expression&quot;" alwaysStopAt="true"/>
        <context>
            <option name="OTHER" value="true"/>
        </context>
    </template>

    <template name="main" value="def main() =&gt;&#10;    $V1$.&#10;end" description="Declare the program entry function" toReformat="false" toShortenFQNames="false">
        <variable name="V1" expression="" defaultValue="&quot;expression&quot;" alwaysStopAt="true"/>
        <context>
            <option name="OTHER" value="true"/>
        </context>
    </template>

    <template name="class" value="class $V1$&#10;    key($V2$).&#10;    def $V2$: $V3$.&#10;    def $V4$: $V5$ := $V6$.&#10;end" description="Declare a RocksDB-backed fact schema" toReformat="false" toShortenFQNames="false">
        <variable name="V1" expression="" defaultValue="&quot;entity&quot;" alwaysStopAt="true"/>
        <variable name="V2" expression="" defaultValue="&quot;id&quot;" alwaysStopAt="true"/>
        <variable name="V3" expression="" defaultValue="&quot;string&quot;" alwaysStopAt="true"/>
        <variable name="V4" expression="" defaultValue="&quot;enabled&quot;" alwaysStopAt="true"/>
        <variable name="V5" expression="" defaultValue="&quot;bool&quot;" alwaysStopAt="true"/>
        <variable name="V6" expression="" defaultValue="&quot;true&quot;" alwaysStopAt="true"/>
        <context>
            <option name="OTHER" value="true"/>
        </context>
    </template>

    <template name="condition" value="$V1$ = $V2$ then $V3$ else $V4$." description="Create a conditional expression" toReformat="false" toShortenFQNames="false">
        <variable name="V1" expression="" defaultValue="&quot;left&quot;" alwaysStopAt="true"/>
        <variable name="V2" expression="" defaultValue="&quot;right&quot;" alwaysStopAt="true"/>
        <variable name="V3" expression="" defaultValue="&quot;value&quot;" alwaysStopAt="true"/>
        <variable name="V4" expression="" defaultValue="&quot;fallback&quot;" alwaysStopAt="true"/>
        <context>
            <option name="OTHER" value="true"/>
        </context>
    </template>

    <template name="for" value="for $V1$ in $V2$ then&#10;    $V3$.&#10;end" description="Iterate a list or lazy query cursor" toReformat="false" toShortenFQNames="false">
        <variable name="V1" expression="" defaultValue="&quot;item&quot;" alwaysStopAt="true"/>
        <variable name="V2" expression="" defaultValue="&quot;values&quot;" alwaysStopAt="true"/>
        <variable name="V3" expression="" defaultValue="&quot;expression&quot;" alwaysStopAt="true"/>
        <context>
            <option name="OTHER" value="true"/>
        </context>
    </template>

    <template name="while" value="while $V1$ then&#10;    $V2$.&#10;end" description="Repeat while a Boolean condition is true" toReformat="false" toShortenFQNames="false">
        <variable name="V1" expression="" defaultValue="&quot;condition&quot;" alwaysStopAt="true"/>
        <variable name="V2" expression="" defaultValue="&quot;expression&quot;" alwaysStopAt="true"/>
        <context>
            <option name="OTHER" value="true"/>
        </context>
    </template>

    <template name="switch" value="switch $V1$&#10;case $V2$ then&#10;    $V3$.&#10;default then&#10;    $V4$.&#10;end" description="Create an explicit-break switch block" toReformat="false" toShortenFQNames="false">
        <variable name="V1" expression="" defaultValue="&quot;value&quot;" alwaysStopAt="true"/>
        <variable name="V2" expression="" defaultValue="&quot;expected&quot;" alwaysStopAt="true"/>
        <variable name="V3" expression="" defaultValue="&quot;expression&quot;" alwaysStopAt="true"/>
        <variable name="V4" expression="" defaultValue="&quot;fallback&quot;" alwaysStopAt="true"/>
        <context>
            <option name="OTHER" value="true"/>
        </context>
    </template>

    <template name="try" value="try&#10;    $V1$.&#10;catch $V2$ then&#10;    $V3$.&#10;end" description="Catch a Felidae runtime exception" toReformat="false" toShortenFQNames="false">
        <variable name="V1" expression="" defaultValue="&quot;expression&quot;" alwaysStopAt="true"/>
        <variable name="V2" expression="" defaultValue="&quot;error&quot;" alwaysStopAt="true"/>
        <variable name="V3" expression="" defaultValue="&quot;error.message&quot;" alwaysStopAt="true"/>
        <context>
            <option name="OTHER" value="true"/>
        </context>
    </template>

    <template name="throw" value="throw(kind: $V1$, message: $V2$)." description="Raise a structured exception" toReformat="false" toShortenFQNames="false">
        <variable name="V1" expression="" defaultValue="&quot;runtime&quot;" alwaysStopAt="true"/>
        <variable name="V2" expression="" defaultValue="&quot;\&quot;failed\&quot;&quot;" alwaysStopAt="true"/>
        <context>
            <option name="OTHER" value="true"/>
        </context>
    </template>

    <template name="query" value="$V1$.where($V2$: $V3$)." description="Create a period-terminated RocksDB bucket query" toReformat="false" toShortenFQNames="false">
        <variable name="V1" expression="" defaultValue="&quot;employee&quot;" alwaysStopAt="true"/>
        <variable name="V2" expression="" defaultValue="&quot;active&quot;" alwaysStopAt="true"/>
        <variable name="V3" expression="" defaultValue="&quot;true&quot;" alwaysStopAt="true"/>
        <context>
            <option name="OTHER" value="true"/>
        </context>
    </template>

    <template name="link" value="Link(&#10;    from: $V1$,&#10;    to: $V2$,&#10;    properties: {$V3$: $V4$}&#10;)." description="Create an instance graph link" toReformat="false" toShortenFQNames="false">
        <variable name="V1" expression="" defaultValue="&quot;left&quot;" alwaysStopAt="true"/>
        <variable name="V2" expression="" defaultValue="&quot;right&quot;" alwaysStopAt="true"/>
        <variable name="V3" expression="" defaultValue="&quot;kind&quot;" alwaysStopAt="true"/>
        <variable name="V4" expression="" defaultValue="&quot;connected&quot;" alwaysStopAt="true"/>
        <context>
            <option name="OTHER" value="true"/>
        </context>
    </template>

    <template name="isatom" value="is_atom($V1$)." description="Test whether a value is a data atom" toReformat="false" toShortenFQNames="false">
        <variable name="V1" expression="" defaultValue="&quot;value&quot;" alwaysStopAt="true"/>
        <context>
            <option name="OTHER" value="true"/>
        </context>
    </template>

    <template name="type" value="type($V1$)." description="Return the concrete runtime type name" toReformat="false" toShortenFQNames="false">
        <variable name="V1" expression="" defaultValue="&quot;value&quot;" alwaysStopAt="true"/>
        <context>
            <option name="OTHER" value="true"/>
        </context>
    </template>

</templateSet>
